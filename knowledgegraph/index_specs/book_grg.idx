name: book_grg
roots:
include_types: tp-def,tp-axiom,tp-lemma,tp-thm,tp-proof,tp-claim,tp-prop,tp-cor,tp-conj,tp-note,tp-exp,tp-artifact
auto_include_methods: false
reference_closure: true
reference_closure_max_rounds: 24
include_wrapper_fragments: true
merged_sha_filter: latest
extractor_version_filter: latest
tex_task_kind_filter: tex_knowledge_unit
latest_version_only: true
latest_source_label_only: true
drop_unused_label_anchors: false
order: source
